{
  "name": "cadence-desktop",
  "version": "0.1.0",
  "description": "A natural language task manager with a Rust backend",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "tdev": "tauri dev",
    "build": "vite build",
    "tbuild": "tauri build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:rust": "cargo test --manifest-path core/Cargo.toml",
    "launch": "tauri build --bundles app && open 'src-tauri/target/release/bundle/macos/Cadence.app'"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@skeletonlabs/skeleton": "^3.2.0",
    "@skeletonlabs/skeleton-svelte": "^1.5.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.12",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
